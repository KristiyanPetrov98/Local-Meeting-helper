{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"], "jsx": "react-jsx", "strict": true,
    "esModuleInterop": true, "skipLibCheck": true, "noEmit": true,
    "types": ["node", "vite/client"]
  },
  "include": ["apps/**/*.ts", "apps/**/*.tsx", "packages/**/*.ts", "packages/**/*.tsx", "tests/**/*.ts", "playwright.config.ts", "vitest.config.mts", "apps/**/*.mts"]
}
